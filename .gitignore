/target
Cargo.lock.orig
/tools/node_modules/
/tools/package-lock.json
/e2e/node_modules/

# Runtime state of a locally-run server: config and the accounts
# directory (which holds recoverable password secrets — never commit it).
/accounts/
/config.toml
/hxd-ng.toml
/agreement.txt

# The SQLite store such a server writes (the inbox, chat history and
# news), with the rollback journal, write-ahead log and shared-memory
# files SQLite keeps beside it. Tests make theirs in temporary
# directories, so no database belongs in the tree.
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
